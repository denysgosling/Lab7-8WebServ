@model StoredFile[]
@{ ViewData["Title"] = L["Text005"].Value; }
<div class="page-heading"><div><p class="eyebrow">@L["Text058"]</p><h1>@L["Text059"]</h1><p class="subtext">@L["Text060"]</p></div><span class="pill">@L["Text117", Model.Length]</span></div>
@if (TempData["Success"] is string success) { <div class="alert alert-success" role="status">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
<div class="split"><section class="panel"><div class="panel-title"><h2>@L["Text061"]</h2><span class="number">@L["Text062"]</span></div><form asp-action="Upload" method="post" enctype="multipart/form-data"><div class="drop-zone"><span class="feature-icon" aria-hidden="true">↑</span><label for="file" class="form-label">@L["Text063"]</label><p>@L["Text064"]</p><input id="file" data-empty="@L["Text065"]" class="form-control" type="file" name="file" required accept=".png,.jpg,.jpeg,.gif,.webp,.pdf,.txt,.csv,.zip,.docx,.xlsx,.pptx" /><div class="field-hint" id="file-hint" aria-live="polite">@L["Text065"]</div></div><div class="form-footer"><small>@L["Text066"]</small><button class="btn btn-primary" type="submit">@L["Text067"]</button></div></form></section><aside class="panel note-panel"><span class="feature-icon" aria-hidden="true">▤</span><h3>@L["Text068"]</h3><p>@L["Text069"]</p><hr /><h3>@L["Text070"]</h3><p>@L["Text071"]</p></aside></div>
<div class="section-row"><h2>@L["Text072"]</h2><span>@L["Text073"]</span></div><section class="panel">
@if (Model.Length == 0) { <div class="empty"><span class="feature-icon mx-auto" aria-hidden="true">▤</span><h3>@L["Text074"]</h3><p>@L["Text075"]</p></div> }
else { <div class="table-responsive"><table class="table"><thead><tr><th>@L["Text076"]</th><th>@L["Text077"]</th><th>@L["Text078"]</th><th><span class="visually-hidden">@L["Text079"]</span></th></tr></thead><tbody>@foreach (var file in Model) { <tr><td><span class="filetype">@file.Extension.TrimStart('.').ToUpperInvariant()</span><a class="filename" asp-action="Details" asp-route-name="@file.Name">@file.DisplayName</a></td><td class="text-nowrap">@file.Size</td><td class="text-nowrap">@file.Uploaded.ToString("dd.MM.yyyy HH:mm")</td><td><a asp-action="Download" asp-route-name="@file.Name" aria-label="@L["Text080"] @file.DisplayName">↓</a></td></tr> }</tbody></table></div> }</section>
